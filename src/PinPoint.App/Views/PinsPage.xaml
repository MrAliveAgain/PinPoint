<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PinPoint.Views.PinsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PinPoint.ViewModels">

    <Page.Resources>
        <!--
          Quiet toggles for the view strip: no fill until hovered, and "on" is a soft accent tint with accent text,
          so a switched-on toggle never looks like the main Snip & pin button.
        -->
        <SolidColorBrush x:Key="StripOnFill" Color="{ThemeResource SystemAccentColor}" Opacity="0.16" />
        <SolidColorBrush x:Key="StripOnFillHover" Color="{ThemeResource SystemAccentColor}" Opacity="0.24" />
        <Style x:Key="StripToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <!-- Background so the whole page (not just its text) accepts dropped image files. -->
    <ScrollViewer AllowDrop="True" Background="Transparent" DragOver="Page_DragOver" Drop="Page_Drop">
        <StackPanel MaxWidth="1000" Padding="36,8,36,36" HorizontalAlignment="Stretch">
            <TextBlock Text="Pins" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,20" />

            <!-- Make something: the one accent button, then its quieter siblings. -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Style="{StaticResource AccentButtonStyle}" Click="Snip_Click" CornerRadius="6,0,0,6" Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7A8;" FontSize="16" />
                            <TextBlock Text="Snip &amp; pin" FontWeight="SemiBold" />
                            <TextBlock x:Name="SnipHotkeyText" Opacity="0.65" />
                        </StackPanel>
                    </Button>
                    <!-- Delay like Snipping Tool, joined to the Snip button (this button only; the shortcut snips straight away). -->
                    <DropDownButton x:Name="DelayButton" Style="{StaticResource AccentButtonStyle}" CornerRadius="0,6,6,0" Padding="10,7"
                                    ToolTipService.ToolTip="Delay before the screen is captured (this button only; the shortcut snips straight away)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE916;" FontSize="14" />
                            <TextBlock x:Name="DelayText" Text="Now" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <RadioMenuFlyoutItem x:Name="Delay0" Text="No delay" GroupName="SnipDelay" Tag="0" Click="Delay_Click" />
                                <RadioMenuFlyoutItem x:Name="Delay3" Text="3 seconds" GroupName="SnipDelay" Tag="3" Click="Delay_Click" />
                                <RadioMenuFlyoutItem x:Name="Delay5" Text="5 seconds" GroupName="SnipDelay" Tag="5" Click="Delay_Click" />
                                <RadioMenuFlyoutItem x:Name="Delay10" Text="10 seconds" GroupName="SnipDelay" Tag="10" Click="Delay_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>

                <DropDownButton Padding="12,7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE737;" FontSize="15" />
                        <TextBlock Text="Pin a window" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="WindowMenu" Placement="BottomEdgeAlignedLeft" Opening="WindowMenu_Opening" />
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Button Click="NewNote_Click" Padding="12,7" ToolTipService.ToolTip="Open a note that floats on top">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE70B;" FontSize="15" />
                        <TextBlock Text="Note" />
                    </StackPanel>
                </Button>

                <Button Click="NewTimer_Click" Padding="12,7" ToolTipService.ToolTip="Pin a countdown or stopwatch on top">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE916;" FontSize="15" />
                        <TextBlock Text="Timer" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--
              The view strip: one calm glass bar for everything about seeing past or controlling pins.
              Peek | Hide (notes, snips, windows, all) | click-through, quick slots.
            -->
            <Border Margin="0,12,0,0" Padding="4" HorizontalAlignment="Left" CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Resources>
                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="StripOnFill" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="StripOnFillHover" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="StripOnFill" />
                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentTextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AccentTextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AccentTextFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="StripOnFill" />
                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                </Border.Resources>

                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton x:Name="PeekToggle" Click="Peek_Click" Style="{StaticResource StripToggleStyle}"
                                  ToolTipService.ToolTip="Peek: slide pins out to the screen edges to get at what's under them, then back (shortcut: tap to toggle, hold to peek while held)">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE7C4;" FontSize="14" />
                            <TextBlock Text="Peek" />
                        </StackPanel>
                    </ToggleButton>

                    <Rectangle Width="1" Margin="6,8" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <FontIcon Glyph="&#xED1A;" FontSize="13" Margin="6,0,2,0" Opacity="0.6"
                              ToolTipService.ToolTip="Hide (click again to show)" />
                    <ToggleButton x:Name="HideNotesToggle" Click="HideNotes_Click" Style="{StaticResource StripToggleStyle}"
                                  ToolTipService.ToolTip="Hide every note (click again to show them)">
                        <TextBlock Text="Notes" />
                    </ToggleButton>
                    <ToggleButton x:Name="HideSnipsToggle" Click="HideSnips_Click" Style="{StaticResource StripToggleStyle}"
                                  ToolTipService.ToolTip="Hide every snip (click again to show them)">
                        <TextBlock Text="Snips" />
                    </ToggleButton>
                    <ToggleButton x:Name="HideWindowsToggle" Click="HideWindows_Click" Style="{StaticResource StripToggleStyle}"
                                  ToolTipService.ToolTip="Hide every pinned app window (click again to show them)">
                        <TextBlock Text="Windows" />
                    </ToggleButton>
                    <ToggleButton x:Name="HideAllToggle" Click="HideAll_Click" Style="{StaticResource StripToggleStyle}"
                                  ToolTipService.ToolTip="Hide all pins (click again to show them)">
                        <TextBlock Text="All" />
                    </ToggleButton>

                    <Rectangle Width="1" Margin="6,8" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <ToggleButton x:Name="ClickThroughToggle" Click="ClickThrough_Click" Style="{StaticResource StripToggleStyle}"
                                  ToolTipService.ToolTip="Click-through: clicks pass through every pin">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8B0;" FontSize="14" />
                            <TextBlock Text="Click-through" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="QuickSlotsToggle" Click="QuickSlots_Click" Style="{StaticResource StripToggleStyle}"
                                  ToolTipService.ToolTip="Quick slots: floating glass buttons for any action, one click each (right-click a slot to choose its action, drag to move)">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xF0E2;" FontSize="14" />
                            <TextBlock Text="Quick slots" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Border>

            <TextBlock Text="Pinned now" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock x:Name="MultiSelectHint" Style="{StaticResource CardDescriptionStyle}" Margin="2,-4,0,8"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Text="Shift- or Ctrl-click to select several (Ctrl+A for all), then drag any selected slider to fade them together." />

            <!-- Extended selection: click, Shift-click, Ctrl-click, Ctrl+A. A selected row's slider fades every selected pin. -->
            <ListView x:Name="PinList" SelectionMode="Extended"
                      ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PinItem">
                        <Border Style="{StaticResource CardStyle}" Padding="10,8" MinHeight="0">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail: rounded, hairline-framed, like a photo on glass. -->
                                <Border Width="76" Height="48" CornerRadius="6" BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Grid>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Opacity="0.8" Visibility="{x:Bind IsGlyphVisible}" />
                                        <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                            Visibility="{x:Bind SupportsOpacity}">
                                    <FontIcon Glyph="&#xE706;" FontSize="13" Opacity="0.55"
                                              ToolTipService.ToolTip="Opacity" />
                                    <Slider Width="120" Minimum="10" Maximum="100" StepFrequency="5"
                                            Value="{x:Bind OpacityPercent, Mode=TwoWay}" />
                                </StackPanel>

                                <!-- Row actions: quiet icon buttons, so the slider and the picture lead. -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <Button Click="CopyText_Click" Visibility="{x:Bind CanCopyText, Mode=OneWay}"
                                            Style="{StaticResource SubtleButtonStyle}" Padding="9,8"
                                            ToolTipService.ToolTip="Copy all the text in this snip">
                                        <FontIcon Glyph="&#xE8D2;" FontSize="15" />
                                    </Button>
                                    <Button Click="Remove_Click" Style="{StaticResource SubtleButtonStyle}" Padding="9,8"
                                            ToolTipService.ToolTip="{x:Bind RemoveLabel}">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state -->
            <Border x:Name="EmptyState" Style="{StaticResource CardStyle}" Padding="24,20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Nothing pinned yet" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Snip part of the screen, pin a window or open a note and it'll show up here. Pins float above everything, including games in borderless windowed mode. If a snip has text in it, you can copy the text too." />
                </StackPanel>
            </Border>

            <!-- Always-visible cheat sheet: keyboard shortcuts vs. mouse controls on a snip. -->
            <TextBlock Text="Controls" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel Spacing="4">
                <Border Style="{StaticResource CardStyle}" Padding="20,16">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Keyboard shortcuts" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource CardDescriptionStyle}"
                                       Text="Press these anywhere, even in a game. You can change them in Settings." />
                        </StackPanel>
                        <StackPanel x:Name="ShortcutHints" Spacing="10" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="20,16">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Mouse controls (snips only)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource CardDescriptionStyle}"
                                       Text="Pinned windows keep their own mouse controls; fade them with the shortcuts above." />
                        </StackPanel>
                        <StackPanel x:Name="MouseHints" Spacing="10" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
