<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PinPoint.Views.PinsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PinPoint.ViewModels">

    <!-- Background so the whole page (not just its text) accepts dropped image files. -->
    <ScrollViewer AllowDrop="True" Background="Transparent" DragOver="Page_DragOver" Drop="Page_Drop">
        <StackPanel MaxWidth="1000" Padding="36,8,36,36" HorizontalAlignment="Stretch">
            <TextBlock Text="Pins" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,20" />

            <!-- Primary actions, then the toggles on their own line, so nothing gets cut off at the default size. -->
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Style="{StaticResource AccentButtonStyle}" Click="Snip_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7A8;" FontSize="16" />
                                <TextBlock Text="Snip &amp; pin" />
                                <TextBlock x:Name="SnipHotkeyText" Opacity="0.7" />
                            </StackPanel>
                        </Button>
                        <!-- Delay like Snipping Tool: for this button (the shortcut always snips straight away). -->
                        <DropDownButton x:Name="DelayButton" ToolTipService.ToolTip="Delay before the screen is captured (this button only; the shortcut snips straight away)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE916;" FontSize="14" />
                                <TextBlock x:Name="DelayText" Text="No delay" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <RadioMenuFlyoutItem x:Name="Delay0" Text="No delay" GroupName="SnipDelay" Tag="0" Click="Delay_Click" />
                                    <RadioMenuFlyoutItem x:Name="Delay3" Text="3 seconds" GroupName="SnipDelay" Tag="3" Click="Delay_Click" />
                                    <RadioMenuFlyoutItem x:Name="Delay5" Text="5 seconds" GroupName="SnipDelay" Tag="5" Click="Delay_Click" />
                                    <RadioMenuFlyoutItem x:Name="Delay10" Text="10 seconds" GroupName="SnipDelay" Tag="10" Click="Delay_Click" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>

                    <DropDownButton>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE737;" FontSize="16" />
                            <TextBlock Text="Pin a window" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="WindowMenu" Placement="BottomEdgeAlignedLeft" Opening="WindowMenu_Opening" />
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button Click="NewNote_Click" ToolTipService.ToolTip="Open a note that floats on top">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE70B;" FontSize="16" />
                            <TextBlock Text="New note" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ToggleButton x:Name="HideNotesToggle" Click="HideNotes_Click"
                                  ToolTipService.ToolTip="Hide all notes (click again to show them)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xED1A;" FontSize="14" />
                            <TextBlock Text="Hide notes" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="HideSnipsToggle" Click="HideSnips_Click"
                                  ToolTipService.ToolTip="Hide all snips (click again to show them)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xED1A;" FontSize="14" />
                            <TextBlock Text="Hide snips" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="HideWindowsToggle" Click="HideWindows_Click"
                                  ToolTipService.ToolTip="Hide all pinned windows (click again to show them)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xED1A;" FontSize="14" />
                            <TextBlock Text="Hide windows" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="HideAllToggle" Click="HideAll_Click"
                                  ToolTipService.ToolTip="Hide all pins (click again to show them)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xED1A;" FontSize="14" />
                            <TextBlock Text="Hide all" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ClickThroughToggle" Click="ClickThrough_Click" Margin="8,0,0,0"
                                  ToolTipService.ToolTip="Click-through: clicks pass through every pin">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B0;" FontSize="14" />
                            <TextBlock Text="Click-through" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Pinned now" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock x:Name="MultiSelectHint" Style="{StaticResource CardDescriptionStyle}" Margin="2,-4,0,8"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Text="Shift- or Ctrl-click pins to select several (Ctrl+A for all), then drag any selected slider to fade them together." />

            <!-- Extended selection: click, Shift-click, Ctrl-click, Ctrl+A. A selected row's slider fades every selected pin. -->
            <ListView x:Name="PinList" SelectionMode="Extended"
                      ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PinItem">
                        <Border Style="{StaticResource CardStyle}" Padding="12,10">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="64" Height="42" CornerRadius="4"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Grid>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Visibility="{x:Bind IsGlyphVisible}" />
                                        <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                            Visibility="{x:Bind SupportsOpacity}">
                                    <FontIcon Glyph="&#xE706;" FontSize="14" Opacity="0.7"
                                              ToolTipService.ToolTip="Opacity" />
                                    <Slider Width="140" Minimum="10" Maximum="100" StepFrequency="5"
                                            Value="{x:Bind OpacityPercent, Mode=TwoWay}" />
                                </StackPanel>

                                <Button Grid.Column="3" Click="CopyText_Click" Visibility="{x:Bind CanCopyText, Mode=OneWay}"
                                        ToolTipService.ToolTip="Copy all the text in this snip">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8D2;" FontSize="14" />
                                        <TextBlock Text="Copy text" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="4" Content="{x:Bind RemoveLabel}" Click="Remove_Click" MinWidth="80" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state -->
            <Border x:Name="EmptyState" Style="{StaticResource CardStyle}" Padding="24,20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Nothing pinned yet" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Snip part of the screen, pin a window or open a note and it'll show up here. Pins float above everything, including games in borderless windowed mode. If a snip has text in it, you can copy the text too." />
                </StackPanel>
            </Border>

            <!-- Always-visible cheat sheet: keyboard shortcuts vs. mouse controls on a snip. -->
            <TextBlock Text="Controls" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel Spacing="4">
                <Border Style="{StaticResource CardStyle}" Padding="20,16">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Keyboard shortcuts" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource CardDescriptionStyle}"
                                       Text="Press these anywhere, even in a game. You can change them in Settings." />
                        </StackPanel>
                        <StackPanel x:Name="ShortcutHints" Spacing="10" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="20,16">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Mouse controls (snips only)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource CardDescriptionStyle}"
                                       Text="Pinned windows keep their own mouse controls; fade them with the shortcuts above." />
                        </StackPanel>
                        <StackPanel x:Name="MouseHints" Spacing="10" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
