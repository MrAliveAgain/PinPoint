<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PinPoint.Views.PinsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PinPoint.ViewModels">

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="36,8,36,36" HorizontalAlignment="Stretch">
            <TextBlock Text="Pins" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,20" />

            <!-- Primary actions -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource AccentButtonStyle}" Click="Snip_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7A8;" FontSize="16" />
                        <TextBlock Text="Snip &amp; pin" />
                        <TextBlock x:Name="SnipHotkeyText" Opacity="0.7" />
                    </StackPanel>
                </Button>

                <DropDownButton Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE737;" FontSize="16" />
                        <TextBlock Text="Pin a window" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="WindowMenu" Placement="BottomEdgeAlignedLeft" Opening="WindowMenu_Opening" />
                    </DropDownButton.Flyout>
                </DropDownButton>

                <ToggleButton x:Name="HideAllToggle" Grid.Column="3" Click="HideAll_Click"
                              ToolTipService.ToolTip="Hide or show every pin">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xED1A;" FontSize="16" />
                        <TextBlock Text="Hide all" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton x:Name="ClickThroughToggle" Grid.Column="4" Click="ClickThrough_Click"
                              ToolTipService.ToolTip="Let clicks pass through every pin">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B0;" FontSize="16" />
                        <TextBlock Text="Click-through" />
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <TextBlock Text="Pinned now" Style="{StaticResource SectionHeaderStyle}" />

            <ItemsControl x:Name="PinList" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PinItem">
                        <Border Style="{StaticResource CardStyle}" Padding="12,10">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="64" Height="42" CornerRadius="4"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Grid>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Visibility="{x:Bind IsGlyphVisible}" />
                                        <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                            Visibility="{x:Bind SupportsOpacity}">
                                    <FontIcon Glyph="&#xE706;" FontSize="14" Opacity="0.7"
                                              ToolTipService.ToolTip="Opacity" />
                                    <Slider Width="140" Minimum="10" Maximum="100" StepFrequency="5"
                                            Value="{x:Bind OpacityPercent, Mode=TwoWay}" />
                                </StackPanel>

                                <Button Grid.Column="3" Content="{x:Bind RemoveLabel}" Click="Remove_Click" MinWidth="80" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state -->
            <Border x:Name="EmptyState" Style="{StaticResource CardStyle}" Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Text="Nothing pinned yet" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="EmptyStateText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="ShortcutHints" Spacing="10" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
