<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PinPoint.Views.ImagePinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PinPoint.Controls"
    Title="PinPoint snip">

    <Grid x:Name="Root"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          PointerPressed="Root_PointerPressed"
          PointerMoved="Root_PointerMoved"
          PointerReleased="Root_PointerReleased"
          PointerCaptureLost="Root_PointerCaptureLost"
          PointerWheelChanged="Root_PointerWheelChanged"
          PointerEntered="Root_PointerEntered"
          PointerExited="Root_PointerExited"
          DoubleTapped="Root_DoubleTapped">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Close_Invoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="Copy_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Opened from code on right-button release (not ContextFlyout), so right-hold + scroll can skip it. -->
        <FlyoutBase.AttachedFlyout>
            <MenuFlyout x:Name="Menu" ShouldConstrainToRootBounds="False" Opening="Menu_Opening">
                <MenuFlyoutItem Text="Copy" Click="Copy_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="CopyTextItem" Text="Copy text" Click="CopyText_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <ToggleMenuFlyoutItem x:Name="SelectTextItem" Text="Select text" Click="SelectText_Click">
                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E9;" /></ToggleMenuFlyoutItem.Icon>
                </ToggleMenuFlyoutItem>
                <MenuFlyoutItem Text="Save as…" Click="SaveAs_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE792;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="ShowInFolderItem" Text="Show in folder" Click="ShowInFolder_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="Opacity">
                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE706;" /></MenuFlyoutSubItem.Icon>
                    <RadioMenuFlyoutItem x:Name="Opacity100" Text="100%" GroupName="Opacity" Tag="1.0" Click="Opacity_Click" />
                    <RadioMenuFlyoutItem x:Name="Opacity80" Text="80%" GroupName="Opacity" Tag="0.8" Click="Opacity_Click" />
                    <RadioMenuFlyoutItem x:Name="Opacity60" Text="60%" GroupName="Opacity" Tag="0.6" Click="Opacity_Click" />
                    <RadioMenuFlyoutItem x:Name="Opacity40" Text="40%" GroupName="Opacity" Tag="0.4" Click="Opacity_Click" />
                </MenuFlyoutSubItem>
                <ToggleMenuFlyoutItem x:Name="ClickThroughItem" Text="Click-through" Click="ClickThrough_Click">
                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B0;" /></ToggleMenuFlyoutItem.Icon>
                </ToggleMenuFlyoutItem>
                <MenuFlyoutItem Text="Actual size" Click="ResetZoom_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71E;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Close" Click="Close_Click" KeyboardAcceleratorTextOverride="Middle-click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </FlyoutBase.AttachedFlyout>

        <Image x:Name="PinImage" Stretch="Fill" />

        <!--
          Text-select mode: word boxes drawn in snip pixels on a canvas the size of the snip,
          scaled with the image by the Viewbox, so zooming needs no extra work.
        -->
        <Viewbox x:Name="TextLayer" Stretch="Fill" Visibility="Collapsed">
            <controls:CursorCanvas x:Name="TextCanvas" Background="Transparent"
                                   PointerPressed="TextCanvas_PointerPressed"
                                   PointerMoved="TextCanvas_PointerMoved"
                                   PointerReleased="TextCanvas_PointerReleased"
                                   PointerCaptureLost="TextCanvas_PointerCaptureLost"
                                   DoubleTapped="TextCanvas_DoubleTapped" />
        </Viewbox>

        <!-- Hover chrome: accent outline + text-select toggle + close button. -->
        <Border x:Name="HoverOutline" IsHitTestVisible="False" Opacity="0"
                BorderThickness="1" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.12" />
            </Border.OpacityTransition>
        </Border>

        <StackPanel x:Name="HoverButtons" Opacity="0" IsHitTestVisible="False" Orientation="Horizontal" Spacing="4"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5">
            <StackPanel.OpacityTransition>
                <ScalarTransition Duration="0:0:0.12" />
            </StackPanel.OpacityTransition>

            <!-- Round chips (Styles/PinChips.xaml): solid and smooth over any snip content. -->
            <ToggleButton x:Name="TextModeButton" Visibility="Collapsed" Click="TextModeButton_Click"
                          Style="{StaticResource PinChipToggleButtonStyle}"
                          ToolTipService.ToolTip="Select text: drag over words to copy them">
                <!--
                  A T drawn as geometry in a 7×7 box (the X icon's visible shape is ~6.2×6.2 px):
                  1 px crossbar and a 1 px stem on the centre pixel, on whole pixels so it stays crisp.
                  No font metrics involved, so it centres exactly. PathIcon takes the button's foreground.
                -->
                <PathIcon Width="7" Height="7" Data="M0,0 H7 V1 H0 Z M3,1 H4 V7 H3 Z" />
            </ToggleButton>

            <Button x:Name="CloseButton" Click="Close_Click"
                    Style="{StaticResource PinChipButtonStyle}"
                    ToolTipService.ToolTip="Close (middle-click)">
                <FontIcon Glyph="&#xE711;" FontSize="9" />
            </Button>
        </StackPanel>

        <!-- Transient badge for zoom / opacity changes. -->
        <Border x:Name="Badge" IsHitTestVisible="False" Opacity="0"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6"
                Style="{StaticResource PinOverlayBadgeStyle}">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Border.OpacityTransition>
            <TextBlock x:Name="BadgeText" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{StaticResource PinChipForeground}" />
        </Border>
    </Grid>
</Window>
