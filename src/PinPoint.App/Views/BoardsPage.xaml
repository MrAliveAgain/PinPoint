<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PinPoint.Views.BoardsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PinPoint.Views">

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="36,8,36,36">
            <TextBlock Text="Boards" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" Margin="0,0,0,18"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="A board is a saved set of snips and notes you can come back to, like a document. The open board saves itself as you work, and opens again next time you start PinPoint." />

            <InfoBar x:Name="ExportInfo" IsOpen="False" Margin="0,0,0,12">
                <InfoBar.ActionButton>
                    <HyperlinkButton x:Name="ShowExportButton" Content="Show in folder" Click="ShowExport_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- The board that's open right now (or a prompt to save the current pins as one). -->
            <Border Style="{StaticResource CardStyle}" Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xECA5;" FontSize="22" VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="CurrentTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="CurrentDetail" Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="SaveAsButton" Style="{StaticResource AccentButtonStyle}" Click="SaveAs_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                <TextBlock Text="Save as board…" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportCurrentButton" Click="ExportCurrent_Click"
                                ToolTipService.ToolTip="Save or copy what's pinned as one image, laid out like on screen">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE91B;" FontSize="14" />
                                <TextBlock Text="Export image" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RenameCurrentButton" Content="Rename" Click="RenameCurrent_Click" />
                        <Button x:Name="CloseBoardButton" Content="Close board" Click="CloseBoard_Click"
                                ToolTipService.ToolTip="Saves the board and clears its snips and notes off the screen" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Saved boards" Style="{StaticResource SectionHeaderStyle}" />

            <ItemsControl x:Name="BoardList" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:BoardRow">
                        <Border Style="{StaticResource CardStyle}" Padding="16,10">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!--
                                  Preview (click for a quick look): a placeholder icon until the thumbnail is drawn, or if the board
                                  is empty. On hover its edge lights up in the accent colour and a "Click to preview" strip fades in.
                                -->
                                <Button Padding="0" BorderThickness="2" CornerRadius="6" VerticalAlignment="Center"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        Tag="{x:Bind Id}" Click="Preview_Click"
                                        PointerEntered="Preview_PointerEntered" PointerExited="Preview_PointerExited">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="AccentFillColorDefaultBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="AccentFillColorSecondaryBrush" />
                                    </Button.Resources>
                                    <Grid Width="96" Height="54">
                                        <FontIcon Glyph="&#xECA5;" FontSize="16" Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                        <Border Tag="hint" VerticalAlignment="Bottom" Background="#B0000000" Opacity="0" IsHitTestVisible="False">
                                            <Border.OpacityTransition>
                                                <ScalarTransition Duration="0:0:0.12" />
                                            </Border.OpacityTransition>
                                            <TextBlock Text="Click to preview" FontSize="10" Foreground="White"
                                                       HorizontalAlignment="Center" Margin="0,1,0,2" />
                                        </Border>
                                    </Grid>
                                </Button>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="{x:Bind OpenLabel}" IsEnabled="{x:Bind CanOpen}"
                                        Click="Open_Click" MinWidth="88" />
                                <Button Grid.Column="3" Width="36" Padding="0" ToolTipService.ToolTip="More">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutItem Text="Export as image" Tag="{x:Bind Id}" Click="ExportSaved_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE91B;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Rename" Tag="{x:Bind Id}" Click="Rename_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Delete" Tag="{x:Bind Id}" Click="Delete_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="EmptyBoards" Style="{StaticResource CardStyle}" Padding="24,20">
                <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="No saved boards yet. Pin some snips or notes, then click Save as board." />
            </Border>

            <HyperlinkButton Content="Open the boards folder" Click="OpenFolder_Click" Margin="-12,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
