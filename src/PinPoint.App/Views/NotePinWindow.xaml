<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PinPoint.Views.NotePinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PinPoint note">

    <!-- Placement Hidden: otherwise WinUI pops a "Ctrl+S" tooltip over the whole note on hover, and in a
         topmost window it can stay stuck until another window is clicked. -->
    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="Save_Invoked" />
            <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="SaveAs_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: drag handle + close. -->
        <Grid x:Name="Header" Height="28"
              Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
              PointerPressed="Header_PointerPressed"
              PointerMoved="Header_PointerMoved"
              PointerReleased="Header_PointerReleased"
              PointerCaptureLost="Header_PointerCaptureLost">
            <!-- Right-click the header: everything a note can do, so you don't need the main window or shortcuts. -->
            <Grid.ContextFlyout>
                <MenuFlyout x:Name="Menu" Opening="Menu_Opening">
                    <MenuFlyoutItem Text="New note beside this one" Click="NewNoteButton_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Duplicate" Click="Duplicate_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem Text="Opacity">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE706;" /></MenuFlyoutSubItem.Icon>
                        <RadioMenuFlyoutItem x:Name="Opacity100" Text="100%" GroupName="NoteOpacity" Tag="1.0" Click="Opacity_Click" />
                        <RadioMenuFlyoutItem x:Name="Opacity80" Text="80%" GroupName="NoteOpacity" Tag="0.8" Click="Opacity_Click" />
                        <RadioMenuFlyoutItem x:Name="Opacity60" Text="60%" GroupName="NoteOpacity" Tag="0.6" Click="Opacity_Click" />
                        <RadioMenuFlyoutItem x:Name="Opacity40" Text="40%" GroupName="NoteOpacity" Tag="0.4" Click="Opacity_Click" />
                        <RadioMenuFlyoutItem x:Name="Opacity20" Text="20%" GroupName="NoteOpacity" Tag="0.2" Click="Opacity_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem Text="Click-through for this note only" Click="ClickThroughThisNote_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B0;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <ToggleMenuFlyoutItem x:Name="ClickThroughAllItem" Text="Click-through for all pins" Click="ClickThroughAll_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Save as .txt…" Click="SaveAsMenu_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Close" Click="CloseButton_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Grid.ContextFlyout>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <FontIcon Glyph="&#xE70B;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="HeaderText" Text="Note" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="NewNoteButton" Click="NewNoteButton_Click"
                        Width="34" Height="28" Padding="0" CornerRadius="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="New note next to this one">
                    <FontIcon Glyph="&#xE710;" FontSize="11" />
                </Button>
                <Button x:Name="ClickThroughButton" Click="ClickThroughButton_Click"
                        Width="34" Height="28" Padding="0" CornerRadius="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Click-through: clicks pass through all pins. Click the badge that appears to turn it off. Right-click this bar for just this note.">
                    <FontIcon Glyph="&#xE8B0;" FontSize="11" />
                </Button>
                <Button x:Name="SaveButton" Click="SaveButton_Click"
                        Width="34" Height="28" Padding="0" CornerRadius="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Save as a .txt file (Ctrl+S · Ctrl+Shift+S to save as)">
                    <FontIcon Glyph="&#xE74E;" FontSize="11" />
                </Button>
                <Button x:Name="CloseButton" Click="CloseButton_Click"
                        Width="34" Height="28" Padding="0" CornerRadius="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Close note (its text is kept in the notes\closed folder)">
                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <TextBox x:Name="Editor" Grid.Row="1"
                 AcceptsReturn="True" TextWrapping="Wrap" IsSpellCheckEnabled="False"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 PlaceholderText="Type a note…" Padding="12,10"
                 BorderThickness="0" Background="Transparent"
                 TextChanged="Editor_TextChanged">
            <!-- Plain paper look: no text-box background or focus underline. -->
            <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
            </TextBox.Resources>
        </TextBox>
    </Grid>
</Window>
