<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PinPoint.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="NoteGlassBodyBrush" Color="#80191D24" />
            <Color x:Key="NoteGlassHoverColor">#A6191D24</Color>
            <Color x:Key="NoteEditingColor">#FF191D24</Color>
            <SolidColorBrush x:Key="CardSurfaceBackground" Color="White" Opacity="0.05" />
            <LinearGradientBrush x:Key="CardSurfaceBorder" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#29FFFFFF" Offset="0" />
                <GradientStop Color="#0AFFFFFF" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="NoteGlassBodyBrush" Color="#80F3F5F8" />
            <Color x:Key="NoteGlassHoverColor">#A6F3F5F8</Color>
            <Color x:Key="NoteEditingColor">#FFF3F5F8</Color>
            <SolidColorBrush x:Key="CardSurfaceBackground" Color="Black" Opacity="0.03" />
            <LinearGradientBrush x:Key="CardSurfaceBorder" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A000000" Offset="0" />
                <GradientStop Color="#08000000" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="NoteGlassBodyBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <StaticResource x:Key="NoteGlassHoverColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="NoteEditingColor" ResourceKey="SystemColorWindowColor" />
            <SolidColorBrush x:Key="CardSurfaceBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardSurfaceBorder" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Translucent card with a subtle directional rim. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardSurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardSurfaceBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="64" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="2,24,0,8" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CardDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="controls:SettingsCard">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingsCard">
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{TemplateBinding Glyph}" FontSize="20" VerticalAlignment="Center"
                                      Margin="4,0,4,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}"
                                           Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Content="{TemplateBinding Content}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A single key cap, e.g. [Ctrl]. -->
    <Style x:Key="KeyCapStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="MinWidth" Value="28" />
    </Style>

</ResourceDictionary>
