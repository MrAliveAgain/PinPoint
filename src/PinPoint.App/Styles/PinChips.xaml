<?xml version="1.0" encoding="utf-8"?>
<!--
  Small round overlay buttons drawn on top of snips (the text-select toggle and close).

  Styled like video-player overlay controls: a dark, slightly translucent circle with a white icon.
  That stays readable over white pages and dark games alike without a heavy outline, and doesn't
  depend on the Windows theme. The circle is an Ellipse (vector geometry) rather than a Border with
  CornerRadius, which WinUI draws from stretched corner images and looks uneven at this size.
  Content is centred by its visible shape: use a FontIcon, or for a letter a TextBlock with
  TextLineBounds="Tight" and OpticalMarginAlignment="TrimSideBearings" (otherwise the letter's
  line height and side bearings push it off-centre).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PinChipFill" Color="#D91F1F1F" />
    <SolidColorBrush x:Key="PinChipFillPointerOver" Color="#F2323232" />
    <SolidColorBrush x:Key="PinChipFillPressed" Color="#F2141414" />
    <SolidColorBrush x:Key="PinChipRing" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="PinChipForeground" Color="White" />
    <SolidColorBrush x:Key="PinChipForegroundPressed" Color="#CCFFFFFF" />

    <!-- Badge on a snip ("Copied", "Opacity 60%") in the same overlay look. -->
    <Style x:Key="PinOverlayBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PinChipFill}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="7,2,7,3" />
    </Style>

    <Style x:Key="PinChipButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource PinChipForeground}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Chip" Fill="{StaticResource PinChipFill}"
                                 Stroke="{StaticResource PinChipRing}" StrokeThickness="1" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Fill" Value="{StaticResource PinChipFillPointerOver}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Fill" Value="{StaticResource PinChipFillPressed}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource PinChipForegroundPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same chip as a toggle; "on" switches to the accent colour so the state is obvious. -->
    <Style x:Key="PinChipToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource PinChipForeground}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Chip" Fill="{StaticResource PinChipFill}"
                                 Stroke="{StaticResource PinChipRing}" StrokeThickness="1" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Fill" Value="{StaticResource PinChipFillPointerOver}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Fill" Value="{StaticResource PinChipFillPressed}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource PinChipForegroundPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Fill" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Fill" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled" />
                                <VisualState x:Name="Indeterminate" />
                                <VisualState x:Name="IndeterminatePointerOver" />
                                <VisualState x:Name="IndeterminatePressed" />
                                <VisualState x:Name="IndeterminateDisabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
