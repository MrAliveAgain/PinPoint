<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI-free core: Win32 interop, hotkeys, window pinning, screen capture, settings.
    Kept free of WinUI so it stays fast to build and easy to unit test.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PinPoint.Core</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PinPoint.Core.Tests" />
  </ItemGroup>

</Project>
